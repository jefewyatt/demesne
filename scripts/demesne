#!/usr/bin/env python3
"""demesne — CLI for Jeff's homelab repo.

Wraps day-to-day repo tasks and walks through "Adding a new host" from README.md.

Install (optional):
    ln -sf "$(pwd)/scripts/demesne" ~/.local/bin/demesne

Examples:
    demesne bootstrap --print-only
    demesne host add media --arch amd64 --address 192.168.1.50 --appdata /srv/appdata
    demesne host script media -o /tmp/media-bootstrap.sh
    demesne new nas recipe-api --build
    demesne validate
    demesne ls
    demesne ports nas
"""

from __future__ import annotations

import argparse
import re
import shlex
import subprocess
import sys
import textwrap
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from validate import REPO, collect_used_ports, discover_services, load_hosts, Report  # noqa: E402

HOST_KEY_RE = re.compile(r"^[a-z][a-z0-9-]*$")
ARCHES = ("amd64", "arm64")
KOMODO_LAN = "komodo.lan"
KOMODO_PORT = 9120


# --------------------------------------------------------------------------- #
# hosts.toml helpers
# --------------------------------------------------------------------------- #

def _hosts() -> dict:
    try:
        return load_hosts()
    except Exception as e:  # noqa: BLE001 — surface parse/IO errors cleanly
        print(f"Can't read hosts.toml: {e}", file=sys.stderr)
        sys.exit(2)


def _nas_address(hosts: dict) -> str:
    nas = hosts.get("hosts", {}).get("nas")
    if not nas or not nas.get("address"):
        return "192.168.1.96"
    return str(nas["address"])


def _format_host_block(
    key: str,
    *,
    arch: str,
    address: str,
    appdata: str,
    description: str,
    reserved_ports: list[int],
) -> str:
    ports = ", ".join(str(p) for p in reserved_ports)
    desc = description.replace("\n", " ").strip() or f"{key} host"
    return textwrap.dedent(f"""\

        [hosts.{key}]
        arch = "{arch}"
        description = "{desc}"
        address = "{address}"
        appdata = "{appdata}"
        reserved_ports = [{ports}]
        """)


def _append_host_to_toml(block: str) -> None:
    path = REPO / "hosts.toml"
    text = path.read_text(encoding="utf-8")
    if not text.endswith("\n"):
        text += "\n"
    path.write_text(text + block, encoding="utf-8", newline="\n")


# --------------------------------------------------------------------------- #
# Bootstrap script / checklist (README: Adding a new host)
# --------------------------------------------------------------------------- #

def host_bootstrap_script(
    key: str,
    cfg: dict,
    *,
    nas_address: str,
    onboarding_key: str = "O-PASTE-YOUR-KEY",
) -> str:
    """Shell script to run *on the new host* for README steps 2–4."""
    appdata = cfg["appdata"]
    return textwrap.dedent(f"""\
        #!/usr/bin/env bash
        # Bootstrap host '{key}' for demesne / Komodo Periphery.
        # Generated by: demesne host script {key}
        # Run on the new machine as a user with sudo.
        set -euo pipefail

        echo "==> 2. Prepare the machine (Docker + appdata)"
        if ! command -v docker >/dev/null 2>&1; then
          curl -fsSL https://get.docker.com | sudo sh
        else
          docker --version
        fi
        sudo mkdir -p {shlex.quote(appdata)}

        echo "==> 3. Trust Komodo TLS and resolve {KOMODO_LAN}"
        if ! grep -qE '[[:space:]]{KOMODO_LAN}([[:space:]]|$)' /etc/hosts 2>/dev/null; then
          echo "{nas_address} {KOMODO_LAN}" | sudo tee -a /etc/hosts >/dev/null
        else
          echo "    {KOMODO_LAN} already present in /etc/hosts"
        fi

        CA_SRC="${{1:-./komodo-root-ca.crt}}"
        if [[ ! -f "$CA_SRC" ]]; then
          echo "Missing CA file: $CA_SRC" >&2
          echo "Copy komodo-root-ca.crt from the NAS (bootstrap/nas/komodo/export-ca.sh) here, then re-run:" >&2
          echo "  $0 /path/to/komodo-root-ca.crt" >&2
          exit 1
        fi
        sudo cp "$CA_SRC" /usr/local/share/ca-certificates/komodo-root-ca.crt
        sudo update-ca-certificates

        echo "==> 4. Install Periphery (--connect-as={key})"
        if [[ "{onboarding_key}" == "O-PASTE-YOUR-KEY" ]]; then
          echo "Replace O-PASTE-YOUR-KEY with a real onboarding key from Komodo → Settings → Onboarding." >&2
          exit 1
        fi
        curl -sSL https://raw.githubusercontent.com/moghtech/komodo/main/scripts/setup-periphery.py \\
          | sudo python3 - \\
          --core-address="wss://{KOMODO_LAN}:{KOMODO_PORT}" \\
          --connect-as={shlex.quote(key)} \\
          --onboarding-key={shlex.quote(onboarding_key)}

        sudo systemctl enable --now periphery

        echo
        echo "Done. In Komodo → Servers, '{key}' should show OK."
        echo "Then scaffold services:  demesne new {key} <name> --build"
        """)


def host_nas_checklist(key: str, address: str) -> str:
    return textwrap.dedent(f"""\
        On the NAS (before / alongside Periphery on {key}):
          1. Add {address} to KOMODO_ALLOWED_SOURCES in the Komodo .env
          2. Re-run bootstrap/nas/komodo/firewall.sh so {address} can open TCP {KOMODO_PORT}
          3. Export the CA if needed:  bootstrap/nas/komodo/export-ca.sh
             (copy komodo-root-ca.crt onto the new host for the bootstrap script)
        See bootstrap/README.md steps 2 and 4.
        """)


def host_next_steps(key: str, cfg: dict, nas_address: str) -> str:
    lines = [
        f"Host '{key}' recorded in hosts.toml.",
        "",
        "Next (README → Adding a new host):",
        f"  • Commit/merge the hosts.toml change (or include it with the first service PR).",
        f"  • On the NAS: allow {cfg['address']} — see checklist below.",
        f"  • On {key}: run the bootstrap script:",
        f"      demesne host script {key} --onboarding-key O-... -o /tmp/{key}-bootstrap.sh",
        f"      # scp script + komodo-root-ca.crt to {key}, then:",
        f"      bash {key}-bootstrap.sh ./komodo-root-ca.crt",
        f"  • Confirm Komodo → Servers → {key} is OK.",
        f"  • Scaffold a service:  demesne new {key} <name> --build",
        "",
        host_nas_checklist(key, cfg["address"]).rstrip(),
        "",
        "Komodo core (for reference):",
        f"  NAS address: {nas_address}",
        f"  UI:          https://{KOMODO_LAN}:{KOMODO_PORT}",
        f"  Periphery:   wss://{KOMODO_LAN}:{KOMODO_PORT}  --connect-as={key}",
    ]
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def cmd_host_add(args: argparse.Namespace) -> int:
    key = args.key
    if not HOST_KEY_RE.fullmatch(key):
        print("host key must be lowercase letters, digits, dashes; start with a letter", file=sys.stderr)
        return 2

    hosts = _hosts()
    if key in hosts["hosts"]:
        print(f"host '{key}' already exists in hosts.toml", file=sys.stderr)
        return 1

    reserved = list(dict.fromkeys(args.reserved_port or [22]))
    description = args.description or f"{key} host"
    block = _format_host_block(
        key,
        arch=args.arch,
        address=args.address,
        appdata=args.appdata.rstrip("/") or args.appdata,
        description=description,
        reserved_ports=reserved,
    )

    if args.dry_run:
        print("# dry-run: would append to hosts.toml:\n")
        print(block.rstrip() + "\n")
        print("# and create hosts/{0}/ + komodo/stacks/{0}/".format(key))
        print("# Then:")
        print(host_next_steps(
            key,
            {"address": args.address, "appdata": args.appdata, "arch": args.arch},
            _nas_address(hosts),
        ).replace(f"Host '{key}' recorded in hosts.toml.",
                  f"Host '{key}' would be recorded in hosts.toml.", 1))
        return 0

    _append_host_to_toml(block)
    (REPO / "hosts" / key).mkdir(parents=True, exist_ok=True)
    (REPO / "komodo" / "stacks" / key).mkdir(parents=True, exist_ok=True)

    # Drop a .gitkeep so empty dirs survive in git until the first service lands.
    for d in (REPO / "hosts" / key, REPO / "komodo" / "stacks" / key):
        keep = d / ".gitkeep"
        if not any(p for p in d.iterdir() if p.name != ".gitkeep"):
            keep.write_text("", encoding="utf-8")

    cfg = {
        "arch": args.arch,
        "address": args.address,
        "appdata": args.appdata.rstrip("/") or args.appdata,
        "description": description,
        "reserved_ports": reserved,
    }
    print(f"Appended [hosts.{key}] to hosts.toml")
    print(f"Created hosts/{key}/ and komodo/stacks/{key}/")
    print()
    print(host_next_steps(key, cfg, _nas_address(hosts)))

    if args.write_script:
        script_path = Path(args.write_script)
        script_path.write_text(
            host_bootstrap_script(key, cfg, nas_address=_nas_address(hosts),
                                  onboarding_key=args.onboarding_key),
            encoding="utf-8", newline="\n")
        script_path.chmod(script_path.stat().st_mode | 0o111)
        print(f"\nWrote bootstrap script: {script_path}")

    return 0


def cmd_host_script(args: argparse.Namespace) -> int:
    hosts = _hosts()
    key = args.key
    if key not in hosts["hosts"]:
        print(f"unknown host '{key}' (not in hosts.toml)", file=sys.stderr)
        return 1
    cfg = hosts["hosts"][key]
    script = host_bootstrap_script(
        key, cfg, nas_address=_nas_address(hosts), onboarding_key=args.onboarding_key)

    if args.output:
        out = Path(args.output)
        out.write_text(script, encoding="utf-8", newline="\n")
        out.chmod(out.stat().st_mode | 0o111)
        print(f"Wrote {out}")
        print()
        print(host_nas_checklist(key, cfg["address"]).rstrip())
        return 0

    sys.stdout.write(script)
    if sys.stdout.isatty():
        print(file=sys.stderr)
        print(host_nas_checklist(key, cfg["address"]).rstrip(), file=sys.stderr)
    return 0


def cmd_host_list(_args: argparse.Namespace) -> int:
    hosts = _hosts()
    report = Report()
    services = discover_services(hosts, report)
    counts: dict[str, int] = {k: 0 for k in hosts["hosts"]}
    for host, _, _ in services:
        counts[host] = counts.get(host, 0) + 1

    print(f"{'KEY':<12} {'ARCH':<7} {'ADDRESS':<16} {'APPDATA':<22} SERVICES  DESCRIPTION")
    for key, cfg in sorted(hosts["hosts"].items()):
        print(
            f"{key:<12} {cfg.get('arch', '?'):<7} {str(cfg.get('address', '')):<16} "
            f"{str(cfg.get('appdata', '')):<22} {counts.get(key, 0):<8} "
            f"{cfg.get('description', '')}"
        )
    return 0


def cmd_host_show(args: argparse.Namespace) -> int:
    hosts = _hosts()
    key = args.key
    if key not in hosts["hosts"]:
        print(f"unknown host '{key}'", file=sys.stderr)
        return 1
    cfg = hosts["hosts"][key]
    reserved = cfg.get("reserved_ports", [])
    print(f"host:        {key}")
    print(f"arch:        {cfg.get('arch')}")
    print(f"address:     {cfg.get('address')}")
    print(f"appdata:     {cfg.get('appdata')}")
    print(f"reserved:    {', '.join(str(p) for p in reserved) or '(none)'}")
    print(f"description: {cfg.get('description', '')}")
    print()
    print("Used host ports (services + reserved):")
    used = sorted(collect_used_ports(key))
    print("  " + (", ".join(str(p) for p in used) if used else "(none)"))
    print()
    print(host_nas_checklist(key, cfg["address"]).rstrip())
    print()
    print("Bootstrap this machine:")
    print(f"  demesne host script {key} --onboarding-key O-... -o /tmp/{key}-bootstrap.sh")
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    hosts = _hosts()
    report = Report()
    services = discover_services(hosts, report)
    if not services:
        print("No services under hosts/.")
        return 0
    print(f"{'HOST':<12} {'SERVICE':<24} {'URL / COMPOSE'}")
    for host, name, svc_dir in services:
        cfg = hosts["hosts"][host]
        compose = svc_dir / "compose.yaml"
        url = ""
        if compose.is_file():
            text = compose.read_text(encoding="utf-8")
            m = re.search(r'^\s*-\s*"?(\d+):(\d+)"?\s*$', text, re.M)
            if m:
                url = f"http://{cfg.get('address')}:{m.group(1)}"
            else:
                url = compose.relative_to(REPO).as_posix()
        print(f"{host:<12} {name:<24} {url}")
    for w in report.warnings:
        print(f"WARN  {w}", file=sys.stderr)
    for e in report.errors:
        print(f"ERROR {e}", file=sys.stderr)
    return 1 if report.errors else 0


def cmd_ports(args: argparse.Namespace) -> int:
    hosts = _hosts()
    keys = [args.host] if args.host else sorted(hosts["hosts"])
    for key in keys:
        if key not in hosts["hosts"]:
            print(f"unknown host '{key}'", file=sys.stderr)
            return 1
        reserved = set(hosts["hosts"][key].get("reserved_ports", []))
        used = collect_used_ports(key)
        service_ports = sorted(used - reserved)
        print(f"[{key}]")
        print(f"  reserved:  {', '.join(str(p) for p in sorted(reserved)) or '(none)'}")
        print(f"  services:  {', '.join(str(p) for p in service_ports) or '(none)'}")
        print(f"  next free: {next(p for p in range(8100, 9000) if p not in used)}")
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    cmd = [sys.executable, str(REPO / "scripts" / "validate.py")]
    if args.check_images:
        cmd.append("--check-images")
    return subprocess.call(cmd)


def cmd_new(args: argparse.Namespace) -> int:
    """Forward to new_service.py; unknown flags are already captured via parse_known_args."""
    cmd = [sys.executable, str(REPO / "scripts" / "new_service.py"), args.host, args.name]
    if args.build:
        cmd.append("--build")
    if args.image:
        cmd.extend(["--image", args.image])
    if args.port:
        cmd.extend(["--port", args.port])
    if args.container_port is not None:
        cmd.extend(["--container-port", str(args.container_port)])
    if args.description:
        cmd.extend(["--description", args.description])
    return subprocess.call(cmd)


def cmd_info(_args: argparse.Namespace) -> int:
    hosts = _hosts()
    git = hosts.get("git", {})
    report = Report()
    services = discover_services(hosts, report)
    print("demesne / homelab")
    print(f"  repo root:  {REPO}")
    print(f"  git:        {git.get('account')} @ {git.get('provider')}  "
          f"{git.get('repo')}@{git.get('branch')}")
    print(f"  hosts:      {len(hosts.get('hosts', {}))}")
    print(f"  services:   {len(services)}")
    print()
    print("Quick commands:")
    print("  demesne ls                  list services")
    print("  demesne host list           list hosts")
    print("  demesne host add …          register a new machine (edits hosts.toml)")
    print("  demesne host script <key>   emit Periphery bootstrap script")
    print("  demesne bootstrap           first-time NAS setup (interview)")
    print("  demesne new <host> <name>   scaffold a service")
    print("  demesne validate            run scripts/validate.py")
    print("  demesne ports [host]        port map")
    return 0


def cmd_bootstrap(args: argparse.Namespace) -> int:
    """Run or point at bootstrap/nas/interview.sh (core-host first-time setup)."""
    interview = REPO / "bootstrap" / "nas" / "interview.sh"
    if not interview.is_file():
        print(f"Missing {interview.relative_to(REPO)}", file=sys.stderr)
        return 1

    extra = list(args.interview_args or [])
    if args.dry_run and "--dry-run" not in extra:
        extra.append("--dry-run")
    if args.start and "--start" not in extra:
        extra.append("--start")

    if args.print_only or not sys.stdin.isatty():
        print("First-time setup for the core host (NAS).")
        print()
        print("Copy bootstrap material to the NAS, then run the interview there:")
        print()
        print("  scp -r bootstrap/nas <nas-user>@<nas-ip>:~/bootstrap")
        print("  ssh <nas-user>@<nas-ip>")
        print("  cd ~/bootstrap && ./interview.sh          # write configs")
        print("  cd ~/bootstrap && ./interview.sh --start   # also compose up")
        print()
        print(f"From a full checkout on the NAS you can also run:")
        print(f"  {interview}")
        print()
        print("Docs: bootstrap/README.md")
        if args.print_only:
            return 0
        if not sys.stdin.isatty():
            print("stdin is not a TTY; not launching the interview.", file=sys.stderr)
            return 0

    cmd = ["bash", str(interview), *extra]
    print(f"Running: {' '.join(cmd)}")
    return subprocess.call(cmd)


# --------------------------------------------------------------------------- #
# argparse
# --------------------------------------------------------------------------- #

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="demesne",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # --- host ---
    host_p = sub.add_parser("host", help="manage machines in hosts.toml (Jeff)")
    host_sub = host_p.add_subparsers(dest="host_command", required=True)

    add_p = host_sub.add_parser(
        "add",
        help="append a [hosts.<key>] block (README: Adding a new host, step 1)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Example:
              demesne host add media --arch amd64 --address 192.168.1.50 \\
                --appdata /srv/appdata --description "media box" \\
                --reserved-port 22 --reserved-port 8096
            """),
    )
    add_p.add_argument("key", help="host key; must match Komodo --connect-as")
    add_p.add_argument("--arch", required=True, choices=ARCHES)
    add_p.add_argument("--address", required=True, help="LAN IP")
    add_p.add_argument("--appdata", required=True, help="persistent data root, e.g. /srv/appdata")
    add_p.add_argument("--description", default="", help="human-readable note")
    add_p.add_argument("--reserved-port", type=int, action="append",
                       help="port already used outside this repo (repeatable; default: 22)")
    add_p.add_argument("--dry-run", action="store_true", help="print the block; do not write")
    add_p.add_argument("--write-script", metavar="PATH",
                       help="also write the on-host bootstrap script to PATH")
    add_p.add_argument("--onboarding-key", default="O-PASTE-YOUR-KEY",
                       help="Komodo onboarding key embedded in --write-script")
    add_p.set_defaults(func=cmd_host_add)

    script_p = host_sub.add_parser(
        "script",
        help="print/write the on-host bootstrap script (README steps 2–4)",
    )
    script_p.add_argument("key")
    script_p.add_argument("-o", "--output", help="write script to PATH instead of stdout")
    script_p.add_argument("--onboarding-key", default="O-PASTE-YOUR-KEY",
                          help="embed a real O-… key (default leaves a placeholder)")
    script_p.set_defaults(func=cmd_host_script)

    list_h = host_sub.add_parser("list", aliases=["ls"], help="list hosts")
    list_h.set_defaults(func=cmd_host_list)

    show_p = host_sub.add_parser("show", help="show one host + remaining setup hints")
    show_p.add_argument("key")
    show_p.set_defaults(func=cmd_host_show)

    # --- service / new ---
    new_p = sub.add_parser(
        "new",
        aliases=["service-new", "ns"],
        help="scaffold a service (alias for scripts/new_service.py)",
    )
    new_p.add_argument("host")
    new_p.add_argument("name")
    kind = new_p.add_mutually_exclusive_group(required=True)
    kind.add_argument("--build", action="store_true")
    kind.add_argument("--image")
    new_p.add_argument("--port", help="HOST:CONTAINER")
    new_p.add_argument("--container-port", type=int, default=None)
    new_p.add_argument("--description", default="")
    new_p.set_defaults(func=cmd_new)

    svc_p = sub.add_parser("service", help="service helpers")
    svc_sub = svc_p.add_subparsers(dest="service_command", required=True)
    svc_list = svc_sub.add_parser("list", aliases=["ls"], help="list services")
    svc_list.set_defaults(func=cmd_list)
    svc_new = svc_sub.add_parser("new", help="same as demesne new")
    svc_new.add_argument("host")
    svc_new.add_argument("name")
    sk = svc_new.add_mutually_exclusive_group(required=True)
    sk.add_argument("--build", action="store_true")
    sk.add_argument("--image")
    svc_new.add_argument("--port")
    svc_new.add_argument("--container-port", type=int, default=None)
    svc_new.add_argument("--description", default="")
    svc_new.set_defaults(func=cmd_new)

    # --- validate / check ---
    val_p = sub.add_parser("validate", aliases=["check", "v"], help="run scripts/validate.py")
    val_p.add_argument("--check-images", action="store_true")
    val_p.set_defaults(func=cmd_validate)

    # --- list / ls / ports / info ---
    ls_p = sub.add_parser("list", aliases=["ls"], help="list services across hosts")
    ls_p.set_defaults(func=cmd_list)

    ports_p = sub.add_parser("ports", help="show reserved + service host ports")
    ports_p.add_argument("host", nargs="?", help="limit to one host")
    ports_p.set_defaults(func=cmd_ports)

    info_p = sub.add_parser("info", aliases=["status"], help="repo overview + cheat sheet")
    info_p.set_defaults(func=cmd_info)

    boot_p = sub.add_parser(
        "bootstrap",
        aliases=["interview"],
        help="first-time NAS setup via bootstrap/nas/interview.sh",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            On the NAS (after scp -r bootstrap/nas …:~/bootstrap):
              ./interview.sh
              ./interview.sh --start

            From this checkout (interactive TTY):
              demesne bootstrap
              demesne bootstrap --start
              demesne bootstrap --dry-run
              demesne bootstrap --print-only
            """),
    )
    boot_p.add_argument("--dry-run", action="store_true",
                        help="pass --dry-run through to the interview")
    boot_p.add_argument("--start", action="store_true",
                        help="pass --start (compose up + export-ca + firewall)")
    boot_p.add_argument("--print-only", action="store_true",
                        help="print scp/ssh instructions; do not exec the interview")
    boot_p.add_argument("interview_args", nargs="*",
                        help="extra args forwarded to interview.sh")
    boot_p.set_defaults(func=cmd_bootstrap)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
