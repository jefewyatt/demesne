# Copy to .env next to compose.yaml (cp env.example .env) and fill in the CHANGE ME values.
# .env holds secrets: it is gitignored. Never commit it.
#
# Generate the three secrets on the NAS with:  openssl rand -hex 24
#
# Trimmed from the official compose.env; full reference:
#   https://github.com/moghtech/komodo/blob/main/compose/compose.env

COMPOSE_KOMODO_IMAGE_TAG="2"
COMPOSE_KOMODO_BACKUPS_PATH=/tank/appdata/komodo/backups

KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGE_ME

TZ=America/Los_Angeles

#= Core =#
KOMODO_HOST=http://192.168.1.96:9120
KOMODO_TITLE=Homelab
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=jeff
KOMODO_INIT_ADMIN_PASSWORD=CHANGE_ME
KOMODO_DISABLE_USER_REGISTRATION=true

# Must match [hosts.nas] in hosts.toml.
KOMODO_FIRST_SERVER_NAME=nas

# Forgejo signs webhooks with this. Paste the same value into the webhook's Secret field.
KOMODO_WEBHOOK_SECRET=CHANGE_ME
KOMODO_JWT_SECRET=CHANGE_ME
KOMODO_JWT_TTL="1-wk"

KOMODO_MONITORING_INTERVAL="15-sec"
KOMODO_RESOURCE_POLL_INTERVAL="5-min"

#= Periphery (the NAS's own agent) =#
PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
